{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "app", "postgres", "service", "ingress"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "required": ["existingSecret", "port"],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 0
        },
        "minReadySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "type": "object",
          "properties": {
            "maxUnavailable": {
              "type": ["integer", "string"]
            },
            "maxSurge": {
              "type": ["integer", "string"]
            }
          }
        },
        "topologySpreadConstraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["maxSkew", "topologyKey", "whenUnsatisfiable"],
            "properties": {
              "maxSkew": {
                "type": "integer",
                "minimum": 1
              },
              "topologyKey": {
                "type": "string",
                "minLength": 1
              },
              "whenUnsatisfiable": {
                "type": "string",
                "enum": ["DoNotSchedule", "ScheduleAnyway"]
              }
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["existingSecret", "storage"],
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "storage": {
          "type": "object",
          "required": ["className", "size"],
          "properties": {
            "createStorageClass": {
              "type": "boolean"
            },
            "className": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+Gi$"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": ["integer", "string"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    }
  }
}
